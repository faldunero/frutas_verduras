rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Productos: lectura pública, escritura solo admin
    match /productos/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Órdenes: leer propias + admin ve todo, escribir solo propias
    match /ordenes/{orderID} {
      allow read: if request.auth.uid == resource.data.usuarioId || request.auth.token.admin == true;
      allow write: if request.auth.uid == resource.data.usuarioId || request.auth.token.admin == true;
    }

    // Users: leer/escribir solo el propio perfil + admin
    match /users/{userID} {
      allow read, write: if request.auth.uid == userID || request.auth.token.admin == true;
    }

    // Config: lectura pública, escritura solo admin
    match /config/{document=**} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }

    // AnalisisHistorico: solo admin
    match /analisisHistorico/{document=**} {
      allow read, write: if request.auth.token.admin == true;
    }
  }
}
